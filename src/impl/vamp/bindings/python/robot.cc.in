// clang-format off
#include <vamp_python_init.hh>

#include <vamp/bindings/python/robot_helper.hh>
#include <vamp/robots/@robot_name@.hh>
@VAMP_ROBOT_EXTRA_INCLUDE@

void vamp::binding::init_@robot_name@(nanobind::module_ &pymodule)
{
    [[maybe_unused]] auto submodule = vamp::binding::init_robot<vamp::robots::@robot_struct@>(pymodule);
    @VAMP_ROBOT_EXTRA_CALL_LINE@;
}
// clang-format on
